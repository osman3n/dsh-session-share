{
  "name": "@osman3n/dsh-session-share",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Share the whole Session as a self-contained HTML transcript from the per-response action row.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "plugin",
    "session",
    "share",
    "export",
    "html",
    "transcript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osman3n/dsh-session-share.git"
  },
  "bugs": {
    "url": "https://github.com/osman3n/dsh-session-share/issues"
  },
  "homepage": "https://github.com/osman3n/dsh-session-share#readme"
}
